# Java Maven Build outputs
target/
bin/
*.class
*.jar
*.war
*.ear
*.nar

# Maven wrapper cache
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# IDE files
.settings/
.project
.classpath
.factorypath
.springBeans
.sts4-cache/
