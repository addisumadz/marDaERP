# Copy to .env.local for local development
# Backend base URL used by next.config.js rewrites
BACKEND_URL=http://localhost:9092

# Optional: direct API URL fallback used by http-common in development only
NEXT_PUBLIC_API_URL=http://localhost:9092/api/card_managenment/

# NextAuth
# Generate a strong random value (e.g., openssl rand -base64 32)
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
# Set in production to your site URL (e.g., https://app.example.com)
# NEXTAUTH_URL=http://localhost:9000
