[Unit]
Description=WBill Backend Spring Boot Application
After=network.target mysql.service

[Service]
Type=simple
User=wbill
WorkingDirectory=/Documents/systemDataDontDelete2
ExecStart=/usr/bin/java -jar /Documents/systemDataDontDelete2/wbill.jar --spring.profiles.active=prod --spring.config.additional-location=file:/etc/wbill/
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target