server {
    listen 80;
    server_name _;

    # Proxy Next.js app (running on 9000)
    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    # Directly proxy API calls to Spring Boot if you want Nginx to handle /backend
    # This works even with a static export, or if you prefer to offload proxying from Next
    location /backend/ {
        proxy_pass http://127.0.0.1:9092/; # backend WAR
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
