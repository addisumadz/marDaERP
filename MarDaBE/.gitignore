*.log
logs/

# Static CSV reports (keep directories via .gitkeep)
/src/main/resources/static/derash-csv/*
!/src/main/resources/static/derash-csv/.gitkeep

/src/main/resources/static/mobile-csv/*
!/src/main/resources/static/mobile-csv/.gitkeep

/src/main/resources/static/unicash-csv/*
!/src/main/resources/static/unicash-csv/.gitkeep

/src/main/resources/static/mardaarif-csv/*
!/src/main/resources/static/mardaarif-csv/.gitkeep
